{
	"name": "wordpress/block-development-examples",
	"version": "1.0.0",
	"description": "WordPress Block Development Examples",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.2",
		"php-stubs/wordpress-stubs": "^6.8"
	},
	"scripts": {
		"lint": "XDEBUG_MODE=off ./vendor/bin/phpcs --standard=phpcs.xml",
		"fix": "XDEBUG_MODE=off ./vendor/bin/phpcbf --standard=phpcs.xml"
	},
	"config": {
		"allow-plugins": {
			"squizlabs/php_codesniffer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"wp-coding-standards/wpcs": true
		}
	}
}
