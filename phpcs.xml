<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards">
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Extra"/>
	<arg name="extensions" value="php"/>
	<file>.</file>
	<!-- Exclude third-party and generated files -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>**/*.asset.php</exclude-pattern>
	<exclude-pattern>wp-content/themes/twenty*</exclude-pattern>
	<exclude-pattern>wp-content/plugins/akismet</exclude-pattern>
	<exclude-pattern>wp-content/plugins/hello.php</exclude-pattern>

	<!-- Make unused parameters an error instead of warning -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<type>error</type>
	</rule>

	<!-- Allow modern PHP array syntax -->
	<rule ref="Universal.Arrays.DisallowShortArraySyntax">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- Disable WordPress file naming rules for our custom classes -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>wp-content/plugins/client-api-core/includes/*</exclude-pattern>
	</rule>

</ruleset>
