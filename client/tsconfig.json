{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"target": "ES2017",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		"jsx": "preserve",
		"incremental": true,
		"isolatedModules": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"baseUrl": "."
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": [
		"node_modules"
	]
}
