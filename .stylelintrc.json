{
	"extends": [
		"@wordpress/stylelint-config",
		"stylelint-config-tailwindcss"
	],
	"ignoreFiles": [
		"wp-content/**/build/**/*.css",
		"wp-content/plugins/akismet/**/*.css",
		"wp-content/plugins/hello-dolly/**/*.css",
		"wp-content/themes/twenty*/**/*.css",
		"wp-content/mu-plugins/**/*.css",
		"wp-content/upgrade/**/*.css",
		"wp-content/upgrade-temp-backup/**/*.css",
		"wp-content/languages/**/*.css",
		"wp-content/uploads/**/*.css",
		"node_modules/**/*.css",
		"vendor/**/*.css",
		"**/vendor/**/*.css",
		"**/node_modules/**/*.css"
	],
	"rules": {
		"selector-class-pattern": null,
		"rule-empty-line-before": null
	}
}
