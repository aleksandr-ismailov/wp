{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "client-api/sign-in-page",
	"version": "0.1.0",
	"title": "Sign In Page",
	"category": "widgets",
	"icon": "admin-users",
	"description": "Create a sign-in page with configurable content",
	"keywords": [
		"login",
		"sign in",
		"auth",
		"form",
		"user"
	],
	"attributes": {
		"formTitle": {
			"type": "string",
			"default": "Sign In"
		},
		"buttonText": {
			"type": "string",
			"default": "Sign In"
		}
	},
	"supports": {
		"align": true,
		"html": false
	},
	"textdomain": "client-api-blocks",
	"editorScript": "file:../../build/index.js",
	"editorStyle": "file:../../build/index.css",
	"render": "file:./render.php"
}
