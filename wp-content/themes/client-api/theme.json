{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Client API Theme",
	"settings": {
		"blocks": {
			"allowedBlocks": [
				"core/heading",
				"core/paragraph",
				"core/list",
				"core/list-item",
				"core/image",
				"core/columns",
				"core/column",
				"client-api/sign-in-page"
			]
		},
		"color": {
			"palette": [],
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"customGradient": false,
			"background": false,
			"text": false,
			"link": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "Geist, ui-sans-serif, system-ui, sans-serif",
					"name": "Geist Sans",
					"slug": "geist-sans"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "14px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "16px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "18px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "24px",
					"name": "Extra Large"
				},
				{
					"slug": "h6",
					"size": "14px",
					"name": "Heading 6"
				},
				{
					"slug": "h5",
					"size": "16px",
					"name": "Heading 5"
				},
				{
					"slug": "h4",
					"size": "18px",
					"name": "Heading 4"
				},
				{
					"slug": "h3",
					"size": "20px",
					"name": "Heading 3"
				},
				{
					"slug": "h2",
					"size": "24px",
					"name": "Heading 2"
				},
				{
					"slug": "h1",
					"size": "32px",
					"name": "Heading 1"
				}
			],
			"fontWeight": [
				{
					"slug": "normal",
					"name": "Normal",
					"value": "400"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"value": "500"
				},
				{
					"slug": "semibold",
					"name": "Semi Bold",
					"value": "600"
				},
				{
					"slug": "bold",
					"name": "Bold",
					"value": "700"
				}
			],
			"defaultFontSizes": false,
			"customFontSize": false,
			"lineHeight": false,
			"textTransform": false,
			"letterSpacing": false,
			"fontStyle": false
		},
		"spacing": {
			"margin": false,
			"padding": false,
			"customSpacingSize": false
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"layout": {
			"contentSize": false,
			"wideSize": false
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--geist-sans)"
		}
	}
}
