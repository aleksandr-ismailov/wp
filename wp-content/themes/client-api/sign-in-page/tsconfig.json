{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2020"
		],
		"module": "ESNext",
		"moduleResolution": "node",
		"jsx": "react-jsx",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": false
	},
	"include": [
		"src/**/*"
	]
}
