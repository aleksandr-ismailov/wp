{
	"name": "wordpress-block-development-learning",
	"version": "1.0.0",
	"description": "WordPress Block Development Learning Environment",
	"main": "index.js",
	"scripts": {
		"build": "yarn workspaces foreach --all run build",
		"dev": "bash -c 'docker-compose -f .devcontainer/docker-compose.yml up -d && yarn workspace client dev'",
		"stop": "docker-compose -f .devcontainer/docker-compose.yml down",
		"restart": "docker-compose -f .devcontainer/docker-compose.yml restart",
		"logs": "docker-compose -f .devcontainer/docker-compose.yml logs -f",
		"status": "docker-compose -f .devcontainer/docker-compose.yml ps",
		"packages-update": "yarn workspaces foreach --all run packages-update",
		"plugin-zip": "yarn workspaces foreach --all run plugin-zip",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:debug": "wp-scripts test-playwright --debug",
		"lint": "yarn workspaces foreach --all run lint:css && yarn workspaces foreach --all run lint:js && yarn run lint:php",
		"lint:php": "composer lint",
		"format:php": "composer fix",
		"format:css": "yarn workspaces foreach --all run format:css",
		"prepare": "husky install",
		"add-block": "cd wp-content/plugins && yarn dlx @wordpress/create-block@latest",
		"add-block:dynamic": "cd wp-content/plugins && yarn dlx @wordpress/create-block@latest --variant=dynamic",
		"add-block:theme": "cd wp-content/themes/client-api && yarn dlx @wordpress/create-block@latest --namespace=client-api --template=src && cd ../../../ && find wp-content/themes/client-api -name 'package-lock.json' -delete && find wp-content/themes/client-api -name 'node_modules' -type d -exec rm -rf {} + 2>/dev/null || true && yarn install",
		"setup-wp": "docker-compose -f .devcontainer/docker-compose.yml exec wordpress wp core install --url=\"http://localhost:8888\" --title=\"WordPress Block Development\" --admin_user=\"admin\" --admin_password=\"admin\" --admin_email=\"admin@example.com\" --skip-email --allow-root",
		"activate-plugins": "docker-compose -f .devcontainer/docker-compose.yml exec wordpress wp plugin activate --all --exclude=akismet,hello --allow-root"
	},
	"lint-staged": {
		"wp-content/**/*.{js,jsx,ts,tsx}": [
			"wp-scripts lint-js"
		],
		"*.php": [
			"composer lint"
		],
		"wp-content/**/*.{css,scss}": [
			"stylelint --config .stylelintrc.json --allow-empty-input"
		]
	},
	"keywords": [
		"wordpress",
		"gutenberg",
		"blocks",
		"learning"
	],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@playwright/test": "^1.54.1",
		"@types/babel__core": "^7",
		"@types/node": "^22.16.5",
		"@wordpress/eslint-plugin": "^22.13.0",
		"@wordpress/prettier-config": "^4.27.0",
		"@wordpress/scripts": "^30.20.0",
		"@wordpress/stylelint-config": "^23.19.0",
		"eslint": "^8.0.0",
		"eslint-plugin-jest": "^29.0.1",
		"eslint-plugin-jsdoc": "^52.0.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"husky": "^8.0.3",
		"lint-staged": "^13.3.0",
		"prettier": "^3.6.2",
		"stylelint": "^16.23.0",
		"stylelint-config-tailwindcss": "^1.0.0",
		"stylelint-scss": "^6.12.1",
		"typescript": "^5.8.3"
	},
	"packageManager": "yarn@4.5.3",
	"workspaces": [
		"client",
		"wp-content/plugins/*",
		"wp-content/themes/*",
		"wp-content/themes/client-api/*"
	],
	"installConfig": {
		"hoistingLimits": "dependencies"
	},
	"dependencies": {
		"lucide-react": "^0.536.0"
	}
}
